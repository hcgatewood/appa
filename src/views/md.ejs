<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= filepath %></title>

    <link rel="stylesheet" href="/_appa/github-markdown-css/github-markdown-light.css" />
    <link rel="stylesheet" href="/_appa/highlight.js/default.min.css" />
    <link rel="stylesheet" href="/_appa/katex/katex.min.css">
    <%- liveReloadClient %>

    <style>
        .markdown-body {
            box-sizing: border-box;
            min-width: 200px;
            max-width: 980px;
            margin: 0 auto;
            padding: 45px;
        }

        @media (max-width: 767px) {
            .markdown-body {
                padding: 15px;
            }
        }

        .markdown-body pre.mermaid[data-processed] {
            background: none;
            text-align: center;
        }
    </style>
    <script>
      // Mermaid is 5.5 MB, so only pages with a diagram load it
      document.addEventListener("DOMContentLoaded", function () {
        if (!document.querySelector("pre.mermaid")) return;

        const script = document.createElement("script");
        script.src = "/_appa/mermaid/mermaid.min.js";
        script.onload = function () {
          // strict strips HTML from labels and turns off click handlers
          mermaid.initialize({ startOnLoad: false, securityLevel: "strict" });
          drawMermaid(document);

          // A diagram drawn while hidden comes out zero-sized, so one in a closed <details> waits until it opens.
          // toggle doesn't bubble, so listen in the capture phase.
          document.addEventListener("toggle", function (event) {
            if (event.target.open) drawMermaid(event.target);
          }, true);
        };
        document.head.appendChild(script);
      });

      // drawMermaid draws the diagrams under root (the page, or a <details> that just opened), skipping:
      //   - Ones already drawn, which Mermaid marks with data-processed
      //   - Ones inside a closed <details>, which the toggle listener draws when it opens
      function drawMermaid(root) {
        const undrawn = [...root.querySelectorAll("pre.mermaid:not([data-processed])")];
        const visible = undrawn.filter((pre) => !pre.closest("details:not([open])"));
        // suppressErrors draws a bad diagram as an error message instead of stopping the rest
        if (visible.length > 0) mermaid.run({ nodes: visible, suppressErrors: true });
      }
    </script>
</head>

<body>
    <article class="markdown-body">
        <%- content %>
    </article>
</body>
</html>
